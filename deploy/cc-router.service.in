# systemd user unit for a CC-Router host, rendered by deploy/deploy-host.sh.
# The renderer fills in the node binary, the release root (which holds
# releases/ and the `current` symlink), the listen address, the port and an
# optional EnvironmentFile line.
#
# Deploy with `systemctl --user reload` (no request dropped); stop and restart
# with `systemctl --user`, never `cc-router stop`: stop tries to uninstall the
# service, and start would collide with this unit on the port.
[Unit]
Description=CC-Router (multi-account Claude/Codex proxy)
After=network-online.target

[Service]
Type=simple
# The release root, not `current`: the supervisor outlives many releases, and a
# working directory inside a pruned one would make every later fork fail.
WorkingDirectory=@ROOT@
Environment=HOST=@BIND_HOST@
Environment=CC_ROUTER_DAEMON=1
@ENV_FILE_LINE@
ExecStart=@NODE@ @ROOT@/current/dist/cli/index.js supervise --port @PORT@
# Reload replaces the worker without dropping a request: the supervisor keeps
# the socket, starts a worker from the release `current` points at, and lets
# the old one finish its streams (src/daemon/supervisor.ts).
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM goes to the supervisor only; it tells each worker to drain (up to
# drain.limitSeconds, default 600) and save. The stop timeout sits above that.
KillMode=mixed
TimeoutStopSec=660
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=append:%h/.cc-router/cc-router.log
StandardError=append:%h/.cc-router/cc-router.log

[Install]
WantedBy=default.target
